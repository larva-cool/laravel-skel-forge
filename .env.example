APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel-skel-forge.test

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 火山引擎配置
VOLC_ARK_KEY=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# 火山方舟 AI（laravel/ai，volc 驱动由 larva/laravel-ai-volc 提供，支持文本/向量/TTS/图像/视频）
VOLC_ARK_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_TEXT_MODEL=doubao-seed-2-1-lite-260915
# 向量模型（知识库 Embedding，dimensions 可降为 1024）
VOLC_EMBEDDINGS_MODEL=doubao-embedding-vision-251215
VOLC_EMBEDDINGS_DIMENSIONS=2048
# 语音合成（TTS）
VOLC_AUDIO_MODEL=doubao-seed-tts-2.0
VOLC_AUDIO_VOICE=zh_female_gaolengyujie_uranus_bigtts
VOLC_AUDIO_MALE_VOICE=zh_male_qingshuangnanda_mars_bigtts
VOLC_AUDIO_FORMAT=mp3
VOLC_AUDIO_SPEED=1.0
# 图像生成（Seedream，watermark 为 true 时右下角带 AI 水印）
VOLC_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
VOLC_IMAGE_WATERMARK=false
# 视频生成（Seedance，异步任务）
VOLC_VIDEO_MODEL=doubao-seedance-2-5-260628

# TOS配置
TOS_REGION=cn-beijing
TOS_BUCKET=forge-test
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_URL=https://forge-test.soudong.top

# 知识库检索引擎（database=库内暴力余弦，零外部依赖；meilisearch=向量检索下沉引擎）
# 切换为 meilisearch 后需执行 php artisan knowledge:sync-index 迁移存量分块
KNOWLEDGE_ENGINE=database
KNOWLEDGE_MEILI_INDEX=knowledge_chunks

# Meilisearch（KNOWLEDGE_ENGINE=meilisearch 时启用）
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# 微信公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=

# 微信小程序
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_TOKEN=
WECHAT_MINI_AES_KEY=

# 苹果账号登录
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
